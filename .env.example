# =========================
# Variáveis Globais
# =========================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=fakeLocalKey
AWS_SECRET_ACCESS_KEY=fakeLocalSecret

MASTER_KEY=SUA_MASTER_KEY
SERVICE_API_KEY=COLOQUE_AQUI_A_CHAVE_GERADA_NO_AUTH_SERVICE

# =========================
# POSTGRES: auth-service
# =========================
AUTH_POSTGRES_DB=auth_db
AUTH_POSTGRES_USER=auth_user
AUTH_POSTGRES_PASSWORD=auth_pass_123!

# =========================
# POSTGRES: flag-service
# =========================
FLAG_POSTGRES_DB=flags_db
FLAG_POSTGRES_USER=flag_user
FLAG_POSTGRES_PASSWORD=flag_pass_123!

# =========================
# POSTGRES: targeting-service
# =========================
TARGETING_POSTGRES_DB=targeting_db
TARGETING_POSTGRES_USER=targeting_user
TARGETING_POSTGRES_PASSWORD=targeting_pass_123!

# =========================
# Endpoints locais (usados pelos apps para conectar em LocalStack / DynamoDB Local
# NÃO ALTERAR se for rodar local!
# Em produção (AWS) essas vars são REMOVIDAS e o SDK usa os endpoints reais automaticamente.
# =========================
AWS_ENDPOINT_URL_DYNAMODB=http://localhost:8000
AWS_ENDPOINT_URL_SQS=http://localhost:4566
