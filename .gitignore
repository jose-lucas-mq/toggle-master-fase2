# =============================================================
# .gitignore ToggleMaster Tech Challenge FIAP
# Objetivo: NÃO COMMITAR NENHUM SECRETO, estado TF, build caches.
# =============================================================

# ---------- VARIÁVEIS DE AMBIENTE / SECRETS ----------
.env
.env.local
.env.*.local

# ---------- TERRAFORM (estado local e arquivos de trabalho) ----------
terraform/.terraform/
# Descomente a linha abaixo para ignorar o lock de versoes dos providers
terraform/.terraform.lock.hcl
terraform/*.tfstate
terraform/*.tfstate.*
terraform/*.tfplan
terraform/tfplan.binary
terraform/tfplan.json
terraform/crash.log
terraform/override.tf
terraform/override.tf.json
*_override.tf
*_override.tf.json
# Arquivos de variáveis com VALORES REAIS (contêm role ARN, nomes bucket)
terraform/terraform.tfvars
terraform/terraform.tfvars.json

# ---------- KUBERNETES (manifests gerados com segredos / valores reais) ----------
# Gerados por kubernetes/apply.sh (contem ECR URLs, IRSA ARNs, base64 secrets)
kubernetes/*.gen.yaml
# Segredos reais (nao o template)
kubernetes/secrets.yaml


# ---------- PYTHON (flag-service / targeting-service / analytics-service) ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
build/
dist/
*.egg-info/
.installed.cfg
*.egg
pip-log.txt
pip-delete-this-directory.txt
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.whl
.pytest_cache/
.mypy_cache/
.pyc

# ---------- GO (auth-service / evaluation-service) ----------
auth-service/bin/
evaluation-service/bin/
*.test
*.out
/vendor/
# Dependency directories (estamos usando Go modules — vendor é opcional)
# Go workspace file
go.work

# ---------- DOCKER ----------
docker-compose.override.yml

# ---------- EDITORES / IDEs ----------
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# ---------- LOGS ----------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
